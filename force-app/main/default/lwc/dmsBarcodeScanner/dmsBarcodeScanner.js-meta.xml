<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>DMS Barcode Scanner</masterLabel>
    <description>Look up product stock or verify scanned quantities on a company Primary Dispatch.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Product2</object>
                <object>Inventory__c</object>
                <object>DMS_Dispatch__c</object>
            </objects>
            <property
                name="mode"
                type="String"
                label="Scanner mode"
                default="lookup"
                description="Set to dispatch on a DMS Dispatch record page to verify its product lines."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
