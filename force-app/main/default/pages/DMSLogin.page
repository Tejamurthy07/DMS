<apex:page controller="DMSExperienceLoginController"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           docType="html-5.0">
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>DMS | Distributor Sign In</title>
            <style>
                * { box-sizing: border-box; }
                body {
                    margin: 0;
                    min-height: 100vh;
                    display: grid;
                    place-items: center;
                    padding: 24px;
                    color: #172b4d;
                    background: linear-gradient(135deg, #eef4ff 0%, #f7f9fc 55%, #e8f2f0 100%);
                    font-family: Arial, Helvetica, sans-serif;
                }
                .login-shell {
                    width: min(100%, 440px);
                    padding: 42px;
                    border: 1px solid #e3e9f2;
                    border-radius: 22px;
                    background: #fff;
                    box-shadow: 0 24px 70px rgba(31, 54, 87, .13);
                }
                .brand {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    margin-bottom: 34px;
                }
                .brand-mark {
                    display: grid;
                    width: 48px;
                    height: 48px;
                    place-items: center;
                    border-radius: 14px;
                    color: #fff;
                    background: #176b62;
                    font-size: 24px;
                    font-weight: 700;
                }
                .eyebrow {
                    margin: 0 0 5px;
                    color: #60718a;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: .12em;
                    text-transform: uppercase;
                }
                h1 { margin: 0; font-size: 28px; }
                .subtitle { margin: 0 0 28px; color: #60718a; line-height: 1.5; }
                .field { margin-bottom: 19px; }
                label {
                    display: block;
                    margin-bottom: 8px;
                    color: #243954;
                    font-size: 13px;
                    font-weight: 700;
                }
                .text-input {
                    width: 100%;
                    height: 48px;
                    padding: 0 13px;
                    border: 1px solid #cbd5e1;
                    border-radius: 9px;
                    color: #172b4d;
                    background: #fff;
                    font-size: 15px;
                }
                .text-input:focus {
                    border-color: #176b62;
                    outline: 3px solid rgba(23, 107, 98, .14);
                }
                .error {
                    margin: 0 0 18px;
                    padding: 12px 14px;
                    border: 1px solid #f3c4c4;
                    border-radius: 8px;
                    color: #9c2828;
                    background: #fff4f4;
                    font-size: 14px;
                    line-height: 1.45;
                }
                .submit {
                    width: 100%;
                    min-height: 49px;
                    margin-top: 6px;
                    border: 0;
                    border-radius: 9px;
                    color: #fff;
                    background: #176b62;
                    cursor: pointer;
                    font-size: 15px;
                    font-weight: 700;
                }
                .submit:hover { background: #11554e; }
                .secure-note {
                    margin: 24px 0 0;
                    color: #6d7d91;
                    font-size: 12px;
                    line-height: 1.5;
                    text-align: center;
                }
                @media (max-width: 520px) {
                    body { padding: 14px; }
                    .login-shell { padding: 30px 24px; }
                }
            </style>
        </head>
        <body>
            <main class="login-shell">
                <header class="brand">
                    <span class="brand-mark" aria-hidden="true">D</span>
                    <div>
                        <p class="eyebrow">Distributor Management System</p>
                        <h1>Welcome back</h1>
                    </div>
                </header>
                <p class="subtitle">Sign in to securely access your distributor workspace.</p>
                <apex:form >
                    <apex:outputPanel layout="block" styleClass="error" rendered="{!NOT(ISBLANK(errorMessage))}">
                        <apex:outputText value="{!errorMessage}" />
                    </apex:outputPanel>
                    <div class="field">
                        <apex:outputLabel value="Username (often your email)" for="username" />
                        <apex:inputText id="username"
                                        value="{!username}"
                                        styleClass="text-input"
                                        html-autocomplete="username" />
                    </div>
                    <div class="field">
                        <apex:outputLabel value="Password" for="password" />
                        <apex:inputSecret id="password"
                                          value="{!password}"
                                          styleClass="text-input" />
                    </div>
                    <apex:commandButton value="Sign in securely"
                                        action="{!login}"
                                        styleClass="submit" />
                </apex:form>
                <p class="secure-note">Your sign-in is verified directly by Salesforce.</p>
            </main>
        </body>
    </html>
</apex:page>